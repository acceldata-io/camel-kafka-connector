    <kafka.libs.jackson>2.16.2</kafka.libs.jackson>
    <kafka.libs.netty>4.1.118.Final</kafka.libs.netty>
    <kafka.libs.aws-sdk2-bom>2.29.45</kafka.libs.aws-sdk2-bom>
    <kafka.libs.protobuf>3.25.5</kafka.libs.protobuf>
    <kafka.libs.commons-io>2.16.1</kafka.libs.commons-io>
    <kafka.libs.commons-compress>1.26.2</kafka.libs.commons-compress>
    <kafka.libs.commons-codec>1.17.1</kafka.libs.commons-codec>
    <kafka.libs.commons-logging>1.3.0</kafka.libs.commons-logging>
    <kafka.libs.retrofit>2.11.0</kafka.libs.retrofit>
    <kafka.libs.okhttp>4.12.0</kafka.libs.okhttp>
    <kafka.libs.okio>3.9.1</kafka.libs.okio>
    <kafka.libs.kotlin>1.9.25</kafka.libs.kotlin>
    <kafka.libs.snakeyaml-engine>2.7</kafka.libs.snakeyaml-engine>
    <kafka.libs.avro>1.12.1</kafka.libs.avro>
